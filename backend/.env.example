# MongoDB connection string
MONGO_URL=mongodb://localhost:27017

# Database name (default: shiftextra_db)
DB_NAME=shiftextra_db

# Environment: "production" or leave empty for development
ENVIRONMENT=development

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Testing mode: set to "true" during tests to bypass rate limits
TESTING=false

# LibreOffice binary path (optional, for PDF conversion)
LIBREOFFICE_BIN=

# Session lifetime in days (default: 7, minimum: 1)
SESSION_TTL_DAYS=7

# Optional: enable at-rest encryption of occurrence person PII.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset = feature off, behaves exactly as before (no data migration needed either way).
PII_ENC_KEY=

# Optional: Sentry error monitoring. Unset = disabled. sentry-sdk only loads if set.
SENTRY_DSN=

# Optional: set to "1" for a ONE-OFF destructive migration run
# (dedupe duplicate-email users + drop/recreate conflicting indexes).
# Never leave this set on normal deploys.
RUN_INDEX_MIGRATION=