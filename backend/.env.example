# MongoDB connection string
MONGO_URL=mongodb://localhost:27017

# Database name (default: shiftextra_db)
DB_NAME=shiftextra_db

# Environment: "production" or leave empty for development
ENVIRONMENT=development

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Testing mode: set to "true" during tests to bypass rate limits
TESTING=false

# LibreOffice binary path (optional, for PDF conversion)
LIBREOFFICE_BIN=